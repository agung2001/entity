{
  "name": "entity",
  "version": "0.1.0",
  "description": "Vue 3 + Electron desktop application",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "entity": "bin/entity"
  },
  "author": "",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "clean:dev": "bash scripts/clean-dev.sh",
    "start": "electron .",
    "test": "node --test \"electron/**/*.test.cjs\"",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.2.0",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.entity.app",
    "productName": "Entity",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
