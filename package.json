{
  "name": "entity",
  "version": "0.0.10",
  "description": "Vue 3 + Electron desktop application",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "desktopName": "entity.desktop",
  "bin": {
    "entity": "bin/entity"
  },
  "author": "",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "clean:dev": "bash scripts/clean-dev.sh",
    "start": "electron .",
    "test": "npm run test:unit",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac --universal --publish never",
    "package:mac:install": "npm run package:mac && node scripts/install-mac.mjs",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "package:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "package:linux:install": "npm run package:linux && node scripts/install-linux.mjs",
    "serve": "node server/index.cjs",
    "start:server": "npm run build && node server/index.cjs",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f entity",
    "test:unit": "node --test \"tests/unit/**/*.test.cjs\"",
    "test:smoke": "playwright test tests/e2e/smoke",
    "test:regression": "playwright test tests/e2e/full",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "eval:intent": "node scripts/eval-intent.mjs",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:gate": "npm run test:unit && npm run test:smoke",
    "media:posters": "node scripts/readme-media.mjs posters",
    "media:encode": "node scripts/readme-media.mjs encode",
    "media:check": "node scripts/readme-media.mjs check",
    "media:record": "node scripts/record-demos.mjs",
    "media:onboarding": "node scripts/record-onboarding.mjs",
    "media:logo": "node scripts/logo-animation.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/markdown": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@tiptap/vue-3": "^3.35.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "echarts": "^5.6.0",
    "electron-updater": "^6.8.11",
    "marked": "^18.2.0",
    "unzipper": "^0.12.5",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.entity.app",
    "productName": "Entity",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Entity uses the microphone only while voice mode is open, so you can talk to an entity instead of typing. The recording stays on this machine."
      },
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "build/icons",
      "syncDesktopName": true
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "protocols": [
      {
        "name": "Entity",
        "schemes": [
          "entity"
        ]
      }
    ]
  }
}
