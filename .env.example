# Copy to `.env` next to docker-compose.yml, then:
#   docker compose up -d --build
#
# The server refuses to publish itself without an administrator. The compose
# file requires these two values, so a missing password is a startup error rather
# than an unprotected deployment.

ENTITY_ADMIN_EMAIL=you@example.com
ENTITY_ADMIN_PASSWORD=replace-with-a-long-random-password
ENTITY_ADMIN_NAME=Admin

# The only port to expose. nginx proxies https://entity.example.com here.
ENTITY_PORT=1020

# Keep true: nginx terminates TLS for https://entity.example.com
ENTITY_SECURE_COOKIE=true

# Session lifetime in days.
ENTITY_SESSION_DAYS=30

# Optional AI reviewer for pulled content. Leave empty to use the deterministic
# guard only.
# ENTITY_GUARD_AI_URL=https://api.openai.com/v1/chat/completions
# ENTITY_GUARD_AI_MODEL=gpt-4o-mini
# ENTITY_GUARD_AI_KEY=
